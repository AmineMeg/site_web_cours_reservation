# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only! Never expose this key in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_TEACHER_NAME=María Fernández
NEXT_PUBLIC_TEACHER_EMAIL=teacher@example.com

# --- Emails (optional) ---
# If RESEND_API_KEY is set, emails are sent through Resend (https://resend.com, free tier).
# Otherwise, if EMAIL_WEBHOOK_URL is set, a JSON payload is POSTed to it (Zapier/Make/n8n...).
# Otherwise emails are only printed in the server logs.
RESEND_API_KEY=
EMAIL_FROM=Spanish with María <onboarding@resend.dev>
EMAIL_WEBHOOK_URL=

# --- Cron (Vercel adds "Authorization: Bearer $CRON_SECRET" automatically) ---
CRON_SECRET=generate-a-long-random-string
